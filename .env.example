# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME="Company Intelligence & Outreach Platform"

# Security & Encryption
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# For local dev / testing, SQLite or PostgreSQL can be used:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/company_intelligence_crm
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_intelligence_crm

# Redis Configuration (Broker and Cache)
REDIS_URL=redis://localhost:6379/0

# AI / LLM Configuration
# Options: mock, openai, anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search Provider Configuration
# Options: mock, serpapi, tavily
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# Email Provider Configuration
# Options: mock, resend, sendgrid, ses
EMAIL_PROVIDER=mock
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Sender Information & Compliance
EMAIL_FROM_ADDRESS=outreach@company-intelligence.local
EMAIL_FROM_NAME="Company Intelligence Team"
EMAIL_REPLY_TO=replies@company-intelligence.local
EMAIL_WEBHOOK_SECRET=dev-webhook-secret-signing-key

# Scraper & Crawler Controls
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; CompanyIntelligenceBot/1.0; +https://company-intelligence.local/bot)"
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_PAGES_PER_DOMAIN=50
SCRAPER_MAX_CONCURRENT_REQUESTS=3
SCRAPER_REQUEST_DELAY_SECONDS=0.5
PLAYWRIGHT_ENABLED=false

# Multi-Agent Workflow Controls
AGENT_MAX_RETRIES=3
AGENT_MAX_EXECUTION_SECONDS=300
AGENT_MAX_COST_USD_PER_RUN=2.00

# Email Safety Controls
EMAIL_DRY_RUN=true
EMAIL_REQUIRE_APPROVAL=true
EMAIL_AUTO_SEND_ENABLED=false

# Observability
LOG_LEVEL=INFO
